rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /descuentos/{recordId} {
      // La consulta de empleados no tiene login en la interfaz actual.
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /nomina/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /volantesPdf/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /anticipos/{recordId} {
      allow create: if request.resource.data.keys().hasOnly([
        'cedula', 'fecha', 'monto', 'estado', 'solicitadoEn'
      ])
      && request.resource.data.cedula is string
      && request.resource.data.cedula.matches('^[0-9]{6,12}$')
      && request.resource.data.fecha is string
      && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.monto is number
      && request.resource.data.monto > 0
      && request.resource.data.monto <= 100000000
      && request.resource.data.estado == 'pendiente'
      && request.resource.data.solicitadoEn is string
      && request.resource.data.solicitadoEn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T');
      allow read, update, delete: if request.auth != null;
    }
  }
}
