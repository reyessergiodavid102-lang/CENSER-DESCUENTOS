rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /descuentos/{recordId} {
      // La consulta de empleados no tiene login en la interfaz actual.
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /nomina/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /volantesPdf/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
