rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSiteStatsAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && !request.auth.token.email.matches('.*@empleados[.]censer[.]local$');
    }

    function isPortalEmployee() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[0-9]{6,12}@empleados[.]censer[.]local$');
    }

    function areAdvanceRequestsEnabled() {
      return !exists(/databases/$(database)/documents/configuracion/anticipos)
        || get(/databases/$(database)/documents/configuracion/anticipos).data.habilitado == true;
    }

    match /configuracion/anticipos {
      allow get: if isSiteStatsAdmin() || isPortalEmployee();
      allow list: if false;
      allow create, update: if isSiteStatsAdmin()
        && request.resource.data.keys().hasOnly(['habilitado', 'actualizadoEn'])
        && request.resource.data.habilitado is bool
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if false;
    }

    match /visitasWeb/{visitId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && visitId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['fecha', 'creadoEn'])
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.creadoEn == request.time;
      allow get: if isSiteStatsAdmin();
      allow list: if isSiteStatsAdmin();
      allow update, delete: if false;
    }

    match /descuentos/{recordId} {
      // La consulta de empleados no tiene login en la interfaz actual.
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /nomina/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /volantesPdf/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /rodamiento/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /trabajoDiario/{recordId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /prestamos/{recordId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /anticipos/{recordId} {
      allow create: if areAdvanceRequestsEnabled()
      && isPortalEmployee()
      && request.auth.token.email == request.resource.data.cedula + '@empleados.censer.local'
      && request.resource.data.keys().hasOnly([
        'cedula', 'fecha', 'monto', 'estado', 'solicitadoEn'
      ])
      && request.resource.data.cedula is string
      && request.resource.data.cedula.matches('^[0-9]{6,12}$')
      && request.resource.data.fecha is string
      && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.monto is number
      && request.resource.data.monto > 0
      && request.resource.data.monto <= 100000000
      && request.resource.data.estado == 'pendiente'
      && request.resource.data.solicitadoEn is string
      && request.resource.data.solicitadoEn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
      allow read: if isSiteStatsAdmin()
        || (isPortalEmployee()
          && request.auth.token.email == resource.data.cedula + '@empleados.censer.local');
      allow update, delete: if isSiteStatsAdmin();
    }

    match /pqrs/{requestId} {
      allow create: if isPortalEmployee()
        && request.resource.data.keys().hasOnly([
          'cedula', 'tipo', 'asunto', 'detalle', 'estado', 'creadoEn'
        ])
        && request.resource.data.keys().hasAll([
          'cedula', 'tipo', 'asunto', 'detalle', 'estado', 'creadoEn'
        ])
        && request.resource.data.cedula is string
        && request.auth.token.email == request.resource.data.cedula + '@empleados.censer.local'
        && request.resource.data.tipo in ['Petición', 'Queja', 'Reclamo', 'Sugerencia']
        && request.resource.data.asunto is string
        && request.resource.data.asunto.size() >= 3
        && request.resource.data.asunto.size() <= 120
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() >= 10
        && request.resource.data.detalle.size() <= 5000
        && request.resource.data.estado == 'recibida'
        && request.resource.data.creadoEn == request.time;
      allow read: if isSiteStatsAdmin()
        || (isPortalEmployee()
          && request.auth.token.email == resource.data.cedula + '@empleados.censer.local');
      allow update, delete: if false;
    }

    match /empleados/{cedula} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
